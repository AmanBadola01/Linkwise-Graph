# ========================================================
# GraphRAG System Environment Configuration Template
# ========================================================

# --- Neo4j Graph Database ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- Vector Database (ChromaDB) ---
CHROMA_PERSIST_DIR=./chroma_data
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- LLM API Keys ---
# Provider options: "gemini" or "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key (Get free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Auth (REQUIRED: server refuses to start without it) ---
# Private random value, at least 32 characters. Never commit a real one.
JWT_SECRET=replace-with-a-long-random-secret
# JWT_EXPIRE_HOURS=12
# COOKIE_SECURE=true   # enable in production (HTTPS)
# ENVIRONMENT=production  # disables /docs, /redoc, /openapi.json
# MAX_UPLOAD_MB=50

# OpenAI API Key (Optional alternate)
OPENAI_API_KEY=your_openai_api_key_here
